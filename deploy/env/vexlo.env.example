VEXLO_BASE_DOMAIN=vexlo.example.com
VEXLO_HOST_URL=https://vexlo.example.com
VEXLO_ACME_EMAIL=you@example.com
# Set both primary values for the dashboard hostname and both extra values for
# the wildcard tunnel hostname when DNS cannot issue them in one certificate.
VEXLO_TLS_CERT=
VEXLO_TLS_KEY=
VEXLO_TLS_EXTRA_CERT=
VEXLO_TLS_EXTRA_KEY=
VEXLO_REGISTRATION_TOKEN=replace-with-long-random-token
VEXLO_ADMIN_USER=admin
VEXLO_ADMIN_PASS=replace-with-strong-password
VEXLO_CAPTURE_BODY_LIMIT=262144
VEXLO_MAX_REQUEST_BODY_BYTES=2097152
VEXLO_MAX_API_BODY_BYTES=524288
VEXLO_RETENTION_PERIOD=168h
VEXLO_READ_TIMEOUT=15s
VEXLO_WRITE_TIMEOUT=60s
VEXLO_IDLE_TIMEOUT=60s
